# Hosted PostgreSQL (Neon, Supabase, Render, Railway, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/reptrack?sslmode=require

# App server & security
REPTRACK_SECRET_KEY=replace-with-a-random-64-char-hex-string
REPTRACK_HOST=127.0.0.1
PORT=5000
REPTRACK_COOKIE_SECURE=0

# Optional: SMTP for Email OTP verification on new account sign-up
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1

# Optional: Google OAuth 2.0 (Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback
